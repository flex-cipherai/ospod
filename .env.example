# Copy to .env.local for local work. On Netlify set the same names under
# Site configuration -> Environment variables.
#
# NEXT_PUBLIC_* values end up in the browser, so they must never be secrets.

# Supabase: Project Settings -> API Keys (use the "publishable" key, not the secret one).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The site's public address, no trailing slash. Leave empty on Netlify branch deploys
# (Netlify's own URL is used). Set to https://ospod.io at launch.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown on the pricing and legal pages.
NEXT_PUBLIC_CONTACT_EMAIL=

# Set to "true" once Google sign-in is configured in Supabase (Authentication -> Providers -> Google).
NEXT_PUBLIC_GOOGLE_SIGN_IN=false

# --- Milestone 2: uploads and processing (server-side secrets: never NEXT_PUBLIC_) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ospod-media
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
# Only needed where the processing job runs (Trigger.dev), or to run it locally:
SUPABASE_URL=
SUPABASE_SECRET_KEY=
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
