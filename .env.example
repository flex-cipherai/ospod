# Copy to .env for local work. On Netlify set the same names under Site settings -> Environment variables.
# Everything here is public (it ends up in the browser), so never put a secret in it.

# Where signups are sent: the ospod-waitlist Edge Function in the SDFM Supabase project.
VITE_WAITLIST_API_URL=https://kvlietqeafjtwojkqnqa.supabase.co/functions/v1/ospod-waitlist

# Final public address of this site (no trailing slash). Used for share previews and the canonical link.
SITE_URL=https://ospod.sdfmgroup.com

# Shown after signup ("Book a 15-minute call"). Leave empty to hide that button until you have a link.
VITE_CALENDAR_URL=
# Footer "Contact" link. Leave empty to hide it.
VITE_CONTACT_EMAIL=flex@sdfmgroup.com

# Optional ad conversion tracking. Leave empty and nothing third-party is loaded.
VITE_META_PIXEL_ID=
VITE_LINKEDIN_PARTNER_ID=
VITE_LINKEDIN_CONVERSION_ID=
